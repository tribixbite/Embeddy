{
  "name": "Embeddy",
  "short_name": "Embeddy",
  "description": "Convert, compress, inspect, and upload media \u2014 right in your browser.",
  "start_url": "/tools/convert/",
  "display": "standalone",
  "background_color": "#1a1025",
  "theme_color": "#1a1025",
  "orientation": "any",
  "categories": [
    "utilities",
    "photo"
  ],
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            "video/*"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/tools/convert/",
      "accept": {
        "image/gif": [
          ".gif"
        ],
        "image/webp": [
          ".webp"
        ],
        "video/mp4": [
          ".mp4",
          ".m4v"
        ],
        "video/webm": [
          ".webm"
        ],
        "video/quicktime": [
          ".mov"
        ],
        "video/x-matroska": [
          ".mkv"
        ]
      }
    },
    {
      "action": "/tools/squoosh/",
      "accept": {
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ],
        "image/avif": [
          ".avif"
        ]
      }
    }
  ]
}
