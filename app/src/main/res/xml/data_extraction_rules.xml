<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / device-transfer rules for API 31+ (android:dataExtractionRules).
  Same policy as backup_rules.xml: preferences only, never media.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
